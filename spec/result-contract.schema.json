{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qursor-it/result-driven-development/spec/result-contract.schema.json",
  "title": "RDD Result Contract",
  "type": "object",
  "required": ["id", "version", "intent", "actor", "given", "outcome", "thresholds", "capabilities", "witness"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^R-[0-9]{3,}$" },
    "version": { "type": "integer", "minimum": 1 },
    "intent": { "type": "string", "minLength": 1, "description": "One sentence: what must be true for the actor." },
    "actor": { "type": "string", "minLength": 1 },
    "given": { "type": "string", "description": "Initial conditions." },
    "outcome": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "oracle": { "type": "string", "description": "Deterministic check of the final state, e.g. 'stdout == \"3\\n\"' or 'GET /api/projects returns 1 item'." }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["runs"],
      "properties": {
        "runs": { "type": "integer", "minimum": 1 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p50_time_to_result_s": { "type": "number", "minimum": 0 },
        "p95_time_to_result_s": { "type": "number", "minimum": 0 },
        "max_steps": { "type": "integer", "minimum": 1 },
        "max_memory_mb": { "type": "number", "minimum": 0 },
        "serious_a11y_violations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": ["number", "integer", "string"] }
    },
    "anti_results": { "type": "array", "items": { "type": "string" } },
    "hidden": { "type": "boolean", "default": false, "description": "If true, the Builder must not see the oracles." },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net.host": { "type": "array", "items": { "type": "string" } },
        "fs.read": { "type": "array", "items": { "type": "string" } },
        "fs.write": { "type": "array", "items": { "type": "string" } },
        "data": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "witness": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["cli", "aleph", "browser"] },
        "target": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "stdin": { "type": "string" },
        "timeout_s": { "type": "number", "minimum": 1 }
      }
    },
    "watch": {
      "type": "object",
      "properties": {
        "interval": { "type": "string", "pattern": "^[0-9]+(m|h|d)$" },
        "target": { "type": "string" }
      }
    },
    "owner": { "type": "string" }
  }
}
